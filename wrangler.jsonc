{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "epsilon",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "preview_urls": true,
  // Requerido por Cloudflare Previews (Preview command: npx wrangler preview)
  "previews": {},
  // Formulario de contacto: Cloudflare Email (requiere Email Routing en epsilonwork.cl y el destino verificado)
  "send_email": [{ "name": "SEND_EMAIL", "destination_address": "contacto@epsilonwork.cl" }],
  "vars": { "CONTACT_FROM": "web@epsilonwork.cl", "CONTACT_TO": "contacto@epsilonwork.cl" }
}
